#!/usr/bin/env bash
# avo-stall-detect — no-LLM stagnation check over ledger.jsonl. Single source of truth
# for stall logic (the `avo` driver shells out to this). Deployable standalone as a
# Hermes `no_agent` watchdog or a bare cron guard.
#   exit 0 + prints a reason  => stalled
#   exit 1 + silent           => healthy
#   exit 2 + prints to stderr => configuration/parse error (fail loud, not "healthy")
# Reads thresholds from avo.toml if present (inline comments handled); flags override.
#   avo-stall-detect [--ledger PATH] [--stall-window N] [--cycle-window N]
#                    [--reject-ratio F] [--repeat-max N] [--min-cycle-delta-pct F]
set -o pipefail
LEDGER="ledger.jsonl"; SW=8; CW=10; RR=0.8; REP=3; MCD=0.01

# read one scalar from avo.toml, stripping surrounding quotes and inline comments
read_toml() {
  [ -f avo.toml ] || return
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" avo.toml | head -1 \
    | sed -e 's/[[:space:]]*#.*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//" \
          -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}
isnum() { printf '%s' "$1" | grep -Eq '^[-+]?[0-9]*\.?[0-9]+$'; }

for k in stall_window:SW cycle_window:CW reject_ratio:RR repeat_edit_max:REP min_cycle_delta_pct:MCD; do
  key="${k%%:*}" var="${k##*:}"; v=$(read_toml "$key")
  if [ -n "$v" ]; then isnum "$v" || { echo "avo-stall-detect: non-numeric $key='$v' in avo.toml" >&2; exit 2; }; eval "$var=\$v"; fi
done
while [ $# -gt 0 ]; do case "$1" in
  --ledger) LEDGER="$2"; shift 2;; --stall-window) SW="$2"; shift 2;;
  --cycle-window) CW="$2"; shift 2;; --reject-ratio) RR="$2"; shift 2;;
  --repeat-max) REP="$2"; shift 2;; --min-cycle-delta-pct) MCD="$2"; shift 2;;
  *) echo "unknown flag: $1" >&2; exit 2;;
esac; done
for v in "$SW" "$CW" "$RR" "$REP" "$MCD"; do isnum "$v" || { echo "avo-stall-detect: non-numeric threshold '$v'" >&2; exit 2; }; done
[ -f "$LEDGER" ] || exit 1

# Stall math operates on CANDIDATE ATTEMPTS only (accept/reject); error and redirect
# entries are excluded so infra flakes and redirects never count as stalled ticks.
reason=$(jq -s -r --argjson sw "$SW" --argjson cw "$CW" --argjson rr "$RR" \
                  --argjson rep "$REP" --argjson mcd "$MCD" '
  def tail($n): .[-$n:];
  ( map(select(.action=="accept" or .action=="reject")) ) as $cand |
  ( $cand | map(select(.action=="accept")) ) as $acc |
  # candidate attempts since the last accept = count of trailing candidates whose action != accept
  ( [ $cand[] | .action ] ) as $acts |
  ( ($acts | reverse | (index("accept") // ($acts|length))) ) as $since |
  ( $cand | tail($cw) ) as $win |
  ( ($win|length) ) as $wn |
  ( if $wn>0 then (($win|map(select(.action=="reject"))|length) / $wn) else 0 end ) as $rejratio |
  ( [ $win[] | .diff_hash ] | group_by(.) | map(length) | max // 0 ) as $maxrep |
  ( $win | map(select(.action=="accept")) | map(.delta // 0) | add // 0 ) as $cumdelta |
  ( ($acc | last | .objective) // null ) as $best |
  ( if $best==null then null else ($mcd * ($best|fabs)) end ) as $mindelta |
  if $since >= $sw then "stall: \($since) candidate attempts since last accept (>= \($sw))"
  elif $wn >= $cw and $rejratio > $rr then "unproductive: reject-ratio \($rejratio*100|floor)% over last \($cw) attempts"
  elif $wn >= $cw and $maxrep >= $rep then "repeat-edits: identical diff \($maxrep)x in last \($cw) attempts"
  elif $wn >= $cw and $mindelta!=null and ($win|map(select(.action=="accept"))|length)>0 and $cumdelta < $mindelta
       then "unproductive: cumulative accept-delta \($cumdelta) < \($mindelta) over last \($cw) attempts"
  else empty end
' "$LEDGER" 2>/dev/null)
rc=$?
[ "$rc" -ne 0 ] && { echo "avo-stall-detect: ledger parse error in $LEDGER" >&2; exit 2; }

if [ -n "$reason" ]; then echo "$reason"; exit 0; else exit 1; fi
